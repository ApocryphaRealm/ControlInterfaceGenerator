  {
   "id": "winui-version",
   "source": "probe:2026-11-20 Notepad, Paint",
   "text": "Microsoft.UI.Xaml.dll 3.x = WinUI 3; Settings and Explorer load 2.9.x = WinUI 2 (UWP library / XAML islands), so the module's version decides, not its name."
  },
  {
   "id": "winui3-listitem-no-selectionitem",
   "source": "probe:2026-11-20 paint",
   "text": "ListItem does not expose the SelectionItem pattern the UIA spec requires (seen on 53 of them; patterns present: ['Invoke', 'LegacyIAccessible', 'ScrollItem', 'VirtualizedItem'])."
  }
 ]
