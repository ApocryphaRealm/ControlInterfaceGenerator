  {
   "id": "qt6-window-class",
   "source": "probe:2026-11-20 MO2 2.5 (Qt 6.7.1), Equalizer APO Editor (Qt 6.7.2)",
   "text": "Top-level window class is Qt<major><minor><patch>QWindowIcon, e.g. Qt671QWindowIcon; UIA FrameworkId is 'Qt'."
  },
  {
   "id": "qt6-image-has-invoke",
   "source": "probe:2026-11-20 equalizer-apo-editor",
   "text": "Image exposes Invoke, which the UIA spec says it must not."
  },
  {
   "id": "qt6-tabitem-has-invoke",
