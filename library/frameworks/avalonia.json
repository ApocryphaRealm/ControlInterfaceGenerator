 "quirks": [
  {
   "id": "avalonia-combobox-has-scroll",
   "source": "probe:2026-11-20 avalonia-gallery",
   "text": "ComboBox exposes Scroll, which the UIA spec says it must not."
  },
  {
   "id": "avalonia-radiobutton-has-toggle",
   "source": "probe:2026-11-20 avalonia-gallery",
   "text": "RadioButton exposes Toggle, which the UIA spec says it must not."
  },
  {
   "id": "avalonia-tab-no-selection",
   "source": "probe:2026-11-20 avalonia-gallery",
   "text": "Tab does not expose the Selection pattern the UIA spec requires (seen on 1 of them; patterns present: ['LegacyIAccessible', 'Scroll', 'ScrollItem'])."
  },
  {
   "id": "avalonia-combo-options-hidden",
   "source": "probe:2026-11-20 avalonia-gallery (Avalonia 11.2.3)",
   "text": "An open ComboBox exposes no option items to UIA (only unnamed layout Groups, no popup window): the current value is readable (Value, read-only) but choose cannot pick another option."
  },
  {
   "id": "avalonia-listbox-items-as-groups",
   "source": "probe:2026-11-20 avalonia-gallery",
   "text": "ListBox items appear as unnamed Group elements, not ListItem with SelectionItem, so they cannot be selected by name."
  },
  {
   "id": "avalonia-password-not-flagged",
   "source": "probe:2026-11-20 avalonia-gallery",
   "text": "A TextBox with PasswordChar does not set UIA IsPassword; CIG treats an Edit named like a password (library/lexicon/secret-fields.json) as one, so set_secret's deny still applies."
  }
 ]
