{
  "about": "Chromium accessibility (AX) roles -> the UIA-style control types and patterns CIG's rules read, so one rule table (library/rules/uia.json) serves both adapters (plan 2.4: 'CDP rules are the same table over the AX tree'). Properties: checked -> toggle_state, selected -> selected, expanded -> expand_state, readonly -> is_read_only, modal -> is_modal, valuemin/valuemax/valuenow -> range.",
  "source": ["doc: https://chromedevtools.github.io/devtools-protocol/tot/Accessibility/ and the WAI-ARIA role list, read 2026-11-20"],
  "roles": {
    "button": {"control_type": "Button", "patterns": ["Invoke"]},
    "link": {"control_type": "Hyperlink", "patterns": ["Invoke"]},
    "menuitem": {"control_type": "MenuItem", "patterns": ["Invoke"]},
    "menuitemcheckbox": {"control_type": "MenuItem", "patterns": ["Toggle"]},
    "menuitemradio": {"control_type": "MenuItem", "patterns": ["SelectionItem"]},
    "checkbox": {"control_type": "CheckBox", "patterns": ["Toggle"]},
    "switch": {"control_type": "CheckBox", "patterns": ["Toggle"]},
    "togglebutton": {"control_type": "Button", "patterns": ["Toggle"]},
    "radio": {"control_type": "RadioButton", "patterns": ["SelectionItem"]},
    "tab": {"control_type": "TabItem", "patterns": ["SelectionItem"]},
    "textbox": {"control_type": "Edit", "patterns": ["Value"]},
    "searchbox": {"control_type": "Edit", "patterns": ["Value"]},
    "textField": {"control_type": "Edit", "patterns": ["Value"]},
    "spinbutton": {"control_type": "Spinner", "patterns": ["RangeValue", "Value"]},
    "slider": {"control_type": "Slider", "patterns": ["RangeValue"]},
    "combobox": {"control_type": "ComboBox", "patterns": ["ExpandCollapse", "Value"]},
    "listbox": {"control_type": "List", "patterns": ["Selection"]},
    "option": {"control_type": "ListItem", "patterns": ["SelectionItem"]},
    "MenuListPopup": {"control_type": "List", "patterns": []},
    "MenuListOption": {"control_type": "ListItem", "patterns": ["SelectionItem"]},
    "list": {"control_type": "List", "patterns": []},
    "listitem": {"control_type": "ListItem", "patterns": []},
    "tree": {"control_type": "Tree", "patterns": []},
    "treeitem": {"control_type": "TreeItem", "patterns": ["SelectionItem"]},
    "grid": {"control_type": "DataGrid", "patterns": ["Grid"]},
    "table": {"control_type": "Table", "patterns": ["Table"]},
    "row": {"control_type": "DataItem", "patterns": []},
    "dialog": {"control_type": "Window", "patterns": ["Window"]},
    "alertdialog": {"control_type": "Window", "patterns": ["Window"]},
    "menubar": {"control_type": "MenuBar", "patterns": []},
    "menu": {"control_type": "Menu", "patterns": []},
    "tablist": {"control_type": "Tab", "patterns": ["Selection"]},
    "toolbar": {"control_type": "ToolBar", "patterns": []},
    "heading": {"control_type": "Text", "patterns": []},
    "StaticText": {"control_type": "Text", "patterns": []},
    "paragraph": {"control_type": "Text", "patterns": []},
    "img": {"control_type": "Image", "patterns": []},
    "image": {"control_type": "Image", "patterns": []},
    "RootWebArea": {"control_type": "Document", "patterns": ["Text"]},
    "WebArea": {"control_type": "Document", "patterns": []},
    "generic": {"control_type": "Group", "patterns": []},
    "group": {"control_type": "Group", "patterns": []},
    "region": {"control_type": "Group", "patterns": []},
    "navigation": {"control_type": "Group", "patterns": []},
    "main": {"control_type": "Group", "patterns": []},
    "form": {"control_type": "Group", "patterns": []},
    "section": {"control_type": "Group", "patterns": []}
  },
  "skip_roles": ["none", "presentation", "InlineTextBox", "LineBreak", "ignored"]
}
