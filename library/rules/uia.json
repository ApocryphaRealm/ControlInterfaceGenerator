{
  "about": "Adapter rules for UI Automation trees (plan 2.4): element (control type + patterns + properties) -> typed action. Applied in order to every element; a rule with stop=true (the default) ends the matching for that element. Conditions: control_type (any of), patterns_all, patterns_any, patterns_none, and property equalities (is_password, is_read_only, is_modal, enabled).",
  "source": ["doc: learn.microsoft.com uiauto-controltypesoverview / uiauto-controlpatternsoverview"],
  "rules": [
    {"id": "password-field", "when": {"control_type": ["Edit"], "is_password": true},
     "action": "set_secret", "kind": "write", "args": {"text": {"type": "string"}}},
    {"id": "dialog-answer", "when": {"control_type": ["Window"], "is_modal": true},
     "action": "answer_dialog", "kind": "write", "args": {"button": {"type": "string", "enum_from": "child_buttons"}},
     "verify": "gone", "stop": false},
    {"id": "window-close", "when": {"control_type": ["Window"], "patterns_all": ["Window"]},
     "action": "close_window", "kind": "write", "verify": "gone"},
    {"id": "system-menu-bar", "when": {"control_type": ["MenuBar"], "props": {"name": "System"}},
     "action": "system_menu", "kind": "write", "args": {"path": {"type": "string"}},
     "note": "the window's title-bar menu (Restore, Move, Close...) - kept apart so 'menu' is always the application's own (7-Zip FM, Notepad, 2026-11-20)"},
    {"id": "menu-bar", "when": {"control_type": ["MenuBar"]},
     "action": "menu", "kind": "write", "args": {"path": {"type": "string", "enum_from": "menu_paths"}}},
    {"id": "checkable", "when": {"control_type": ["CheckBox", "MenuItem", "Button", "ListItem", "TreeItem", "DataItem"], "patterns_all": ["Toggle"]},
     "action": "set_checked", "kind": "write", "args": {"checked": {"type": "boolean"}}, "verify": "toggle_state"},
    {"id": "button", "when": {"control_type": ["Button", "SplitButton", "Hyperlink"], "patterns_any": ["Invoke", "LegacyIAccessible"]},
     "action": "invoke", "kind": "write"},
    {"id": "selectable", "when": {"control_type": ["RadioButton", "TabItem", "ListItem", "DataItem", "TreeItem"], "patterns_all": ["SelectionItem"]},
     "action": "select", "kind": "write", "verify": "selected", "stop": false},
    {"id": "tree-expand", "when": {"control_type": ["TreeItem"], "patterns_all": ["ExpandCollapse"]},
     "action": "expand", "kind": "write", "args": {"expanded": {"type": "boolean"}}, "verify": "expand_state"},
    {"id": "combo", "when": {"control_type": ["ComboBox"], "patterns_any": ["Selection", "ExpandCollapse", "Value"]},
     "action": "choose", "kind": "write", "args": {"option": {"type": "string", "enum_from": "child_items"}}, "verify": "value"},
    {"id": "edit-value", "when": {"control_type": ["Edit", "Document"], "patterns_all": ["Value"], "is_read_only": false},
     "action": "set_text", "kind": "write", "args": {"text": {"type": "string"}}, "verify": "value", "stop": false},
    {"id": "text-read", "when": {"control_type": ["Edit", "Document", "Text"], "patterns_any": ["Value", "Text"]},
     "action": "get_text", "kind": "read"},
    {"id": "range", "when": {"control_type": ["Slider", "Spinner", "ScrollBar"], "patterns_all": ["RangeValue"]},
     "action": "set_number", "kind": "write", "args": {"value": {"type": "number", "range_from": "range"}}, "verify": "range"},
    {"id": "list-read", "when": {"control_type": ["List", "Tree", "DataGrid", "Table"]},
     "action": "list_items", "kind": "read"},
    {"id": "keys-fallback", "when": {"control_type": ["Window"]},
     "action": "keys", "kind": "write", "args": {"keys": {"type": "string"}}}
  ]
}
