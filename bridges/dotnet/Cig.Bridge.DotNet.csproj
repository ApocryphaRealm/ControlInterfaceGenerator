<Project Sdk="Microsoft.NET.Sdk">
  <!-- CIG's .NET bridge: loaded by .NET's official startup-hook mechanism (DOTNET_STARTUP_HOOKS) into a program CIG
       itself launches. No compile-time reference to any UI framework: it reads Avalonia (and later WPF/WinForms)
       through reflection, so it works across their versions. Build: py -3 tools/build_bridges.py -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>Cig.Bridge.DotNet</AssemblyName>
    <RootNamespace>Cig.Bridge</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- No build-machine path in the shipped DLL (rule 45): source and pdb paths are mapped to /_/, the pdb is embedded. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
